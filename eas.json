{
  "cli": {
    "version": ">= 3.13.3"
  },
  "build": {
    "base": {
      "node": "24.15.0"
    },

    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },

    "preview-ios-sim": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },

    "production": {
      "extends": "base",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
